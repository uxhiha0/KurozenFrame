<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <ImageView
        android:id="@+id/photo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="Kurozen slideshow"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp">

        <LinearLayout
            android:id="@+id/brand"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="12dp"
            android:background="#B0000000">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="𖤐  DZG KUROZEN"
                android:textColor="@color/red"
                android:textSize="22sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="THE BLACK SOVEREIGN"
                android:textColor="@color/muted"
                android:textSize="10sp"/>
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="18dp"
            android:background="#B8000000">

            <TextView
                android:id="@+id/clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12:00"
                android:textColor="@color/white"
                android:textSize="58sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="THURSDAY  •  SEPTEMBER 24"
                android:textColor="@color/red"
                android:textSize="14sp"/>

            <TextView
                android:id="@+id/status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="KUROZEN FRAME  •  ONLINE"
                android:textColor="@color/muted"
                android:textSize="11sp"
                android:layout_marginTop="10dp"/>

            <TextView
                android:id="@+id/photo_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 PHOTOS FOUND"
                android:textColor="#777777"
                android:textSize="9sp"
                android:layout_marginTop="3dp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/admin_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:paddingTop="10dp">

            <Button
                android:id="@+id/refresh"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="REFRESH PHOTOS"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:background="@drawable/button"/>

            <Button
                android:id="@+id/settings"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:text="ANDROID SETTINGS"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:background="@drawable/button"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="KUROZEN FRAME v1.0  •  DZG"
            android:textColor="#555555"
            android:textSize="9sp"
            android:gravity="center"
            android:layout_marginTop="10dp"/>
    </LinearLayout>
</FrameLayout>
